# ====================================================
# HireLoop Client Environment Template (.env.example)
# Copy this file to .env and fill in values for your deployment
# ====================================================

# Client Application URL (e.g. https://your-hireloop.vercel.app in production)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend REST API Server URL (e.g. https://your-hireloop-server.onrender.com)
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# Better-Auth Secret (openssl rand -base64 32)
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Database Connection (MongoDB Atlas connection string)
BETTER_AUTH_DB_URI=mongodb+srv://<username>:<password>@cluster0.lldqhrj.mongodb.net/

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
